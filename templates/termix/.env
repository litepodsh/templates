# Used only by the commented host-port mapping in compose.yml.
TERMIX_PORT=8080

# Secrets. LitePod generates these once and keeps them across redeploys.
# They must stay stable: changing JWT_SECRET invalidates sessions, and the two
# keys open the encrypted database and the credentials stored in it.
JWT_SECRET={{openssl_rand_48}}
DATABASE_KEY={{openssl_rand_32}}
ENCRYPTION_KEY={{openssl_rand_32}}
INTERNAL_AUTH_TOKEN={{openssl_rand_32}}
