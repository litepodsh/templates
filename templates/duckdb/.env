# Used only by the commented host-port mapping in compose.yml.
DUCKDB_PORT=9494

# Authentication token every Quack client must present (min 4 characters).
# Applied on every boot; rotate by changing it and restarting the service.
DUCKDB_AUTH_TOKEN={{password_32}}

DUCKDB_HEALTHCHECK_INTERVAL=10s
DUCKDB_HEALTHCHECK_TIMEOUT=10s
DUCKDB_HEALTHCHECK_RETRIES=5
DUCKDB_HEALTHCHECK_START_PERIOD=30s