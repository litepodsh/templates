# Used only by the commented host-port mapping in compose.yml.
DUCKDB_PORT=9494

# Authentication token every Quack client must present. Baked into the
# bootstrap script written on first boot, so rotating it requires a fresh
# volume (podman compose down -v) or editing init.sql inside it.
DUCKDB_AUTH_TOKEN={{password_32}}

DUCKDB_HEALTHCHECK_INTERVAL=30s
DUCKDB_HEALTHCHECK_TIMEOUT=10s
DUCKDB_HEALTHCHECK_RETRIES=5
DUCKDB_HEALTHCHECK_START_PERIOD=90s