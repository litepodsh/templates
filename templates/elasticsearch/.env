# Used only by the commented host-port mapping in compose.yml.
ELASTICSEARCH_PORT=9200

# Password for the built-in `elastic` superuser (set on first boot only).
ELASTICSEARCH_PASSWORD={{password_32}}

ELASTICSEARCH_SECURITY_ENABLED=true
# TLS on the HTTP layer is left to the reverse proxy; keep this false for the
# internal port. Set true only if you terminate TLS inside the container.
ELASTICSEARCH_HTTP_SSL_ENABLED=false

# JVM heap. Set -Xms and -Xmx to the same value, roughly half the RAM you give
# the container (and no more than ~31g).
ELASTICSEARCH_JAVA_OPTS=-Xms1g -Xmx1g

ELASTICSEARCH_CLUSTER_NAME=elasticsearch

ELASTICSEARCH_HEALTHCHECK_INTERVAL=15s
ELASTICSEARCH_HEALTHCHECK_TIMEOUT=10s
ELASTICSEARCH_HEALTHCHECK_RETRIES=10
ELASTICSEARCH_HEALTHCHECK_START_PERIOD=60s
