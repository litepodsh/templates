# Used only by the commented host-port mapping in compose.yml.
INFISICAL_PORT=8080

# Public URL Infisical is served from. Used for invite links and OAuth callbacks.
INFISICAL_SITE_URL=http://localhost:8080

# openssl rand -hex 16  (32 hex characters). Encrypts every stored secret —
# back it up; losing it makes the database unreadable.
INFISICAL_ENCRYPTION_KEY={{openssl_rand_16}}
# openssl rand -base64 32
INFISICAL_AUTH_SECRET={{openssl_rand_32}}

INFISICAL_DB_NAME=infisical
INFISICAL_DB_USER=infisical
INFISICAL_DB_PASSWORD={{password_32}}

INFISICAL_TELEMETRY_ENABLED=false

INFISICAL_DB_HEALTHCHECK_INTERVAL=10s
INFISICAL_DB_HEALTHCHECK_TIMEOUT=5s
INFISICAL_DB_HEALTHCHECK_RETRIES=10
