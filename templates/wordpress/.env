# Used only by the commented host-port mapping in compose.yml.
WORDPRESS_PORT=8080

WORDPRESS_DB_NAME=wordpress
WORDPRESS_DB_USER=wordpress
WORDPRESS_DB_PASSWORD={{password_32}}
WORDPRESS_DB_ROOT_PASSWORD={{password_32}}

WORDPRESS_DB_HEALTHCHECK_INTERVAL=10s
WORDPRESS_DB_HEALTHCHECK_TIMEOUT=5s
WORDPRESS_DB_HEALTHCHECK_RETRIES=10
