# Used only by the commented host-port mapping in compose.yml.
APTABASE_PORT=8000

# Public URL of the dashboard. Login and activation links are built from it.
APTABASE_BASE_URL={{url}}
APTABASE_AUTH_SECRET={{password_32}}

APTABASE_DB_NAME=aptabase
APTABASE_DB_USER=aptabase
APTABASE_DB_PASSWORD={{password_32}}

APTABASE_CLICKHOUSE_USER=aptabase
APTABASE_CLICKHOUSE_PASSWORD={{password_32}}

# Optional. Without SMTP, sign-in and activation links are printed to the
# aptabase container logs.
APTABASE_SMTP_HOST=
APTABASE_SMTP_PORT=587
APTABASE_SMTP_USERNAME=
APTABASE_SMTP_PASSWORD=
APTABASE_SMTP_FROM_ADDRESS=
