# Used only by the commented host-port mapping in compose.yml.
ELECTERM_PORT=8082

# Login. LitePod generates these once and keeps them across redeploys.
ELECTERM_USER=electerm
ELECTERM_PASSWORD={{password_32}}
ELECTERM_SERVER_SECRET={{openssl_rand_32}}
ELECTERM_ENABLE_AUTH=1
# Blocks a shell inside the container itself; SSH/SFTP to your own hosts still works.
ELECTERM_DISABLE_LOCAL_TERMINAL=1
