# Public address of the web UI. Used for sign-in redirects and API CORS.
OPENEXECUTIVE_URL={{url}}

# Model provider. At least one is required or the API refuses to start:
# an Anthropic key, or OpenRouter (set OPENROUTER_ENABLED=true and its key).
ANTHROPIC_API_KEY=
# Only for an organisation-level Anthropic key; leave empty for a workspace key.
ANTHROPIC_WORKSPACE_ID=
OPENROUTER_ENABLED=false
OPENROUTER_API_KEY=

DEFAULT_MODEL=claude-sonnet-5-5
DEEP_REASONING_MODEL=claude-sonnet-5-5
ROUTING_MODEL=claude-haiku-5-5
# Model for one answer after the user pushes back on the last one. Empty = off.
PUSHBACK_MODEL=
ENABLE_CACHING=true

# The Executive's own mailbox. Required: the API won't start without it. Set it to the Google
# or Microsoft 365 account the Executive signs in as; the default is a placeholder.
EXEC_EMAIL_ADDRESS=exec@example.com

# Sign-in: Google and/or any OpenID Connect provider. Set at least one.
# Only these emails can sign in (comma-separated).
ALLOWED_EMAILS=
AUTH_SECRET={{base64_32}}
# Google OAuth client. Redirect URI: <your url>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# OIDC (Keycloak, Okta, Authentik, Entra ID, ...). Redirect URI: <your url>/api/auth/callback/oidc
AUTH_OIDC_ISSUER=
AUTH_OIDC_ID=
AUTH_OIDC_SECRET=
AUTH_OIDC_NAME=SSO

# Shared secret between the UI and the API.
BACKEND_SHARED_SECRET={{openssl_rand_32}}
# Optional signed callers. Make the pair with scripts/make-caller-keys.py in the repo;
# the private key goes to the UI and the public key to the API.
CALLER_ASSERTION_PRIVATE_KEY=
CALLER_ASSERTION_PUBLIC_KEYS=
# Optional: origins of other apps allowed to frame the UI.
OE_HOST_ORIGINS=
