GITEA_MIRROR_PORT=4321
GITEA_MIRROR_CONTAINER_PORT=4321
GITEA_MIRROR_NODE_ENV=production
GITEA_MIRROR_HOST=0.0.0.0
GITEA_MIRROR_DATABASE_URL=file:data/gitea-mirror.db
GITEA_MIRROR_BASE_URL=/
# Replace with a unique secret of at least 32 characters before deployment.
GITEA_MIRROR_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
GITEA_MIRROR_AUTH_URL=http://localhost:4321
GITEA_MIRROR_PUBLIC_AUTH_URL=http://localhost:4321
GITEA_MIRROR_AUTH_TRUSTED_ORIGINS=http://localhost:4321
GITEA_MIRROR_ISSUE_CONCURRENCY=3
GITEA_MIRROR_PULL_REQUEST_CONCURRENCY=5
GITEA_MIRROR_HEALTHCHECK_INTERVAL=30s
GITEA_MIRROR_HEALTHCHECK_TIMEOUT=10s
GITEA_MIRROR_HEALTHCHECK_RETRIES=5
GITEA_MIRROR_HEALTHCHECK_START_PERIOD=15s
