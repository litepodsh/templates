# Host port for the web UI.
SHOUTRRR_PORT=8080

# Public URL Shoutrrr is served from. OAuth callback URLs are built from it.
SHOUTRRR_APP_URL={{url}}
# Laravel encryption key. Changing it later makes stored account tokens
# unreadable.
SHOUTRRR_APP_KEY=base64:{{base64_32}}
SHOUTRRR_APP_DEBUG=false

# Set both to true once the app is served over an HTTPS domain.
SHOUTRRR_OCTANE_HTTPS=false
SHOUTRRR_SESSION_SECURE_COOKIE=false
# Trust the reverse proxy's X-Forwarded-* headers.
SHOUTRRR_TRUSTED_PROXIES=*

# In-container background processes.
SHOUTRRR_QUEUE_WORKER_COUNT=1
SHOUTRRR_INERTIA_SSR_ENABLED=false

# Social login (google, x, linkedin). Needs OAuth credentials; see setup.md.
SHOUTRRR_SOCIALITE_ENABLED=false

# Media storage: "public" (local volume) or "s3" with the AWS_* values below.
SHOUTRRR_FILESYSTEM_DISK=public
SHOUTRRR_AWS_ACCESS_KEY_ID=
SHOUTRRR_AWS_SECRET_ACCESS_KEY=
SHOUTRRR_AWS_DEFAULT_REGION=us-east-1
SHOUTRRR_AWS_BUCKET=
SHOUTRRR_AWS_ENDPOINT=
SHOUTRRR_AWS_URL=
SHOUTRRR_AWS_USE_PATH_STYLE_ENDPOINT=true

# Connected posting accounts. Leave empty to hide a provider.
SHOUTRRR_X_CLIENT_ID=
SHOUTRRR_X_CLIENT_SECRET=
SHOUTRRR_LINKEDIN_CLIENT_ID=
SHOUTRRR_LINKEDIN_CLIENT_SECRET=
SHOUTRRR_FACEBOOK_CLIENT_ID=
SHOUTRRR_FACEBOOK_CLIENT_SECRET=
SHOUTRRR_THREADS_CLIENT_ID=
SHOUTRRR_THREADS_CLIENT_SECRET=
