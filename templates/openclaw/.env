OPENCLAW_VERSION=2026.9.8
OPENCLAW_BROWSER_VERSION=0.3.0
OPENCLAW_PORT=8080
TZ=Etc/UTC

# HTTP basic auth on the UI. Leaving AUTH_PASSWORD empty disables auth.
AUTH_USERNAME=admin
AUTH_PASSWORD={{password_32}}
# Gateway bearer token.
OPENCLAW_GATEWAY_TOKEN={{openssl_rand_32}}
OPENCLAW_GATEWAY_BIND=loopback
# Comma-separated origins allowed to reach the Control UI, e.g. https://claw.example.com
OPENCLAW_ALLOWED_ORIGINS=http://localhost:8080

# Optional override, format provider/model-id. Empty = auto-pick from keys below.
OPENCLAW_PRIMARY_MODEL=

# AI providers — set at least one.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
MOONSHOT_API_KEY=
OPENCODE_API_KEY=
COPILOT_GITHUB_TOKEN=
# e.g. http://host.containers.internal:11434
OLLAMA_BASE_URL=
# Audio transcription (optional)
DEEPGRAM_API_KEY=

# Chat channels (optional)
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
WHATSAPP_ENABLED=false

# Webhooks (optional); HOOKS_TOKEN is required when enabled.
HOOKS_ENABLED=false
HOOKS_TOKEN=
HOOKS_PATH=/hooks

BROWSER_EVALUATE_ENABLED=true
BROWSER_SNAPSHOT_MODE=efficient
# Extra apt packages installed into the agent container at start (space-separated).
OPENCLAW_DOCKER_APT_PACKAGES=
