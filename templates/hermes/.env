HERMES_DASHBOARD_PORT=9119
HERMES_API_PORT=8642

# Web dashboard, protected by the bundled basic-auth provider.
HERMES_DASHBOARD=1
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD={{password_32}}
# Session signing secret.
HERMES_DASHBOARD_BASIC_AUTH_SECRET={{base64_32}}

# OpenAI-compatible API. Bound to 0.0.0.0 so the published port reaches it;
# clients send API_SERVER_KEY as a bearer token.
API_SERVER_ENABLED=true
API_SERVER_HOST=0.0.0.0
API_SERVER_KEY={{openssl_rand_32}}

HERMES_MEMORY_LIMIT=4G
HERMES_CPU_LIMIT=2.0
