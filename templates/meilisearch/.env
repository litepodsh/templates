# Host port for the HTTP API and dashboard.
MEILISEARCH_PORT=7700

# "production" requires the master key and disables the open dashboard.
MEILISEARCH_ENV=production
# Admin API key (16+ bytes). Use it to log in to the dashboard and to create
# search/admin keys.
MEILISEARCH_MASTER_KEY={{password_32}}
# Opt out of anonymous usage telemetry.
MEILISEARCH_NO_ANALYTICS=true
