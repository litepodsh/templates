# The forge that sends webhooks: github, gitlab or gitea (also for Forgejo).
PR_AGENT_PROVIDER=github
# Paste this into the forge's webhook settings. Unsigned webhooks are rejected.
PR_AGENT_WEBHOOK_SECRET={{password_32}}
# Two workers use about 265 MB when idle. More workers handle more webhooks at once.
PR_AGENT_WORKERS=2

# Set the key for the provider of PR_AGENT_MODEL. Anthropic example:
#   PR_AGENT_MODEL=anthropic/claude-opus-5-5
#   PR_AGENT_FALLBACK_MODELS=[]
PR_AGENT_MODEL=gpt-6.1-sol
PR_AGENT_FALLBACK_MODELS=["gpt-6-luna"]
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# For OpenAI-compatible endpoints: use the model name openai/<model>, set this URL and set
# the model's context size in PR_AGENT_CUSTOM_MODEL_MAX_TOKENS if PR-Agent doesn't know it.
OPENAI_API_BASE=
PR_AGENT_CUSTOM_MODEL_MAX_TOKENS=-1

# GitHub only. Encode the key on one line: base64 -w0 key.pem (macOS: base64 -i key.pem)
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_BASE64=

# GitLab only
GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=

# Gitea or Forgejo only
GITEA_URL=https://gitea.com
GITEA_TOKEN=
