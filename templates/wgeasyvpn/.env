# WireGuard must be reachable directly over UDP.
WG_EASY_WIREGUARD_PORT=51820

# The web UI is exposed to LitePod's domain proxy.
WG_EASY_INSECURE=false
# LitePod's default network does not provide IPv6.
WG_EASY_DISABLE_IPV6=true

# These values are used only on the first start. Replace the password before deployment.
WG_EASY_INIT_ENABLED=true
WG_EASY_INIT_USERNAME=admin
WG_EASY_INIT_PASSWORD={{password_12}}
# Domain or public IP that VPN clients use to reach this server.
WG_EASY_INIT_HOST=vpn.example.com
WG_EASY_INIT_PORT=51820
WG_EASY_INIT_DNS=1.1.1.1,1.0.0.1
WG_EASY_IPV4_FORWARDING=1
WG_EASY_SRC_VALID_MARK=1
