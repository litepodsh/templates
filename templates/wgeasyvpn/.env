################
# Published ports
################
WG_EASY_WIREGUARD_PORT=51820
WG_EASY_UI_PORT=51821

###########################
# Web UI container settings
###########################
WG_EASY_UI_CONTAINER_PORT=51821
WG_EASY_UI_BIND_ADDRESS=0.0.0.0
# Set false when the UI is served by an HTTPS reverse proxy.
WG_EASY_INSECURE=true
# Disable IPv6 by default for portable rootful Podman deployments.
WG_EASY_DISABLE_IPV6=true

#########################
# Initial admin/VPN setup
#########################
# These values are used only on the first start. Replace the password before deployment.
WG_EASY_INIT_ENABLED=true
WG_EASY_INIT_USERNAME=admin
WG_EASY_INIT_PASSWORD={{password_12}}
# Public DNS name or public IP clients use to reach this host.
WG_EASY_INIT_HOST=vpn.example.com
WG_EASY_INIT_PORT=51820
WG_EASY_INIT_DNS=1.1.1.1,1.0.0.1
WG_EASY_INIT_IPV4_CIDR=10.8.0.0/24
WG_EASY_INIT_IPV6_CIDR=fd42:42:42::/64
WG_EASY_INIT_ALLOWED_IPS=0.0.0.0/0,::/0

##################
# Network sysctls
##################
WG_EASY_IPV4_FORWARDING=1
WG_EASY_SRC_VALID_MARK=1
WG_EASY_IPV6_DISABLED=1
WG_EASY_IPV6_FORWARDING=0
WG_EASY_IPV6_DEFAULT_FORWARDING=0
