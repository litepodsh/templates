# Edition downloaded on first boot: 11, 11l (LTSC), 10, 10l, 2025, 2022, 2019, tiny11, core11...
# Full list: https://github.com/dockur/windows#how-do-i-select-the-windows-version
WINDOWS_VERSION=11
# Resources given to the VM. Windows 11 needs at least 4G of RAM.
RAM_SIZE=4G
CPU_CORES=2
# Container memory cap: RAM_SIZE plus about 1G for QEMU. Raise both together.
CONTAINER_MEMORY_LIMIT=5g
# Virtual disk size; it can grow later (then extend the partition inside Windows).
DISK_SIZE=64G
# Local administrator created during the unattended install. Only read on first install.
WINDOWS_USERNAME=litepod
WINDOWS_PASSWORD={{password_32}}
WINDOWS_LANGUAGE=English
WINDOWS_REGION=en-US
WINDOWS_KEYBOARD=en-US
# Host port for Remote Desktop (TCP + UDP). Change it if 3389 is taken on the server.
RDP_PORT=3389
