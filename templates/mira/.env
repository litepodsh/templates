# Password for the dashboard's admin user.
MIRA_ADMIN_PASSWORD={{password_24_readable}}

# LLM. By default this is an OpenRouter key and an OpenRouter model id. For any other
# OpenAI-compatible endpoint, also set its URL and use the model id it expects.
MIRA_LLM_API_KEY=
MIRA_MODEL=anthropic/claude-sonnet-4-6
MIRA_LLM_BASE_URL=

# @mention handle. Set it when you connect more than one forge, otherwise Mira uses the
# name of the first one it finds.
MIRA_BOT_NAME=

# GitHub only. Encode the key on one line: base64 -w0 key.pem (macOS: base64 -i key.pem)
MIRA_GITHUB_APP_ID=
MIRA_GITHUB_PRIVATE_KEY_BASE64=
MIRA_GITHUB_WEBHOOK_SECRET={{password_32}}

# GitLab only. For a self-managed instance, use https://gitlab.example.com/api/v4
MIRA_GITLAB_TOKEN=
MIRA_GITLAB_WEBHOOK_SECRET={{password_32}}
MIRA_GITLAB_API_URL=

# Forgejo or Gitea only. Leave the URL empty for Codeberg, or use https://git.example.com/api/v1
MIRA_FORGEJO_TOKEN=
MIRA_FORGEJO_WEBHOOK_SECRET={{password_32}}
MIRA_FORGEJO_API_URL=
