# Used only by the commented host-port mappings in compose.yml.
ENTE_WEB_PORT=3000
ENTE_ALBUMS_PORT=3002
ENTE_API_PORT=8080
ENTE_MINIO_CONSOLE_PORT=3201

# Origins the browser uses. ENTE_API_ORIGIN must point at the museum API as
# reachable from the client (published port or proxied hostname). ENTE_ALBUMS_ORIGIN
# is where public shared albums are served and must match the albums web app.
ENTE_API_ORIGIN=http://localhost:8080
ENTE_ALBUMS_ORIGIN=http://localhost:3002

# --- Crypto secrets: generate these by hand, they are NOT auto-filled ---
# ENTE_KEY_ENCRYPTION : openssl rand -base64 32
# ENTE_KEY_HASH       : openssl rand -base64 64
# ENTE_JWT_SECRET     : openssl rand -base64 32
# Losing them makes existing accounts unrecoverable.
ENTE_KEY_ENCRYPTION=
ENTE_KEY_HASH=
ENTE_JWT_SECRET=

ENTE_DB_NAME=ente
ENTE_DB_USER=ente
ENTE_DB_PASSWORD={{password_32}}

# Connection used by museum to reach the bundled MinIO service.
ENTE_S3_ACCESS_KEY=ente
ENTE_S3_SECRET_KEY={{password_32}}
ENTE_S3_ENDPOINT=minio:3200
ENTE_S3_REGION=eu-central-2
ENTE_S3_BUCKET=b2-eu-cen
ENTE_S3_ARE_LOCAL_BUCKETS=true
ENTE_S3_USE_PATH_STYLE_URLS=true

# SMTP — optional. Without it, sign-up / login OTP codes are printed to the
# museum container log instead of emailed.
ENTE_SMTP_HOST=
ENTE_SMTP_PORT=587
ENTE_SMTP_USERNAME=
ENTE_SMTP_PASSWORD=
ENTE_SMTP_EMAIL=ente@example.com

ENTE_DB_HEALTHCHECK_INTERVAL=10s
ENTE_DB_HEALTHCHECK_TIMEOUT=5s
ENTE_DB_HEALTHCHECK_RETRIES=10
