# Used only by the commented host-port mapping in compose.yml.
WF_PORT=8088

# Login password for the web UI. Hashed with Argon2id before the app starts.
WF_PASSWORD={{password_20_readable}}

# Master key for encrypted secrets (broker and API credentials). Back it up;
# losing it makes stored secrets unreadable.
WF_SECRET_KEY={{base64_32}}

# Public origin of the app. Required by the API when auth is enabled.
WF_CORS_ALLOW_ORIGINS={{url}}

WF_AUTH_TOKEN_TTL_MINUTES=60
WF_REQUEST_TIMEOUT_MS=30000
