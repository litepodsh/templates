# Used only by the commented host-port mapping in compose.yml.
CODE_SERVER_PORT=8080

# Login password for the editor. Replace before deploying.
CODE_SERVER_PASSWORD={{password_12}}

# Password for `sudo` inside the terminal. Set empty to disable passwordless
# sudo prompts you don't want.
CODE_SERVER_SUDO_PASSWORD={{password_12}}

CODE_SERVER_TZ=UTC
