# Used only by the commented host-port mapping in compose.yml.
FORMBRICKS_PORT=3000

# Public URL Formbricks is served from. Also used as NEXTAUTH_URL. Survey embeds
# and links are built from this, so it must be the real external origin.
FORMBRICKS_WEBAPP_URL=http://localhost:3000

FORMBRICKS_NEXTAUTH_SECRET={{openssl_rand_32}}
# 32-character hex string. Encrypts survey data and integration credentials.
FORMBRICKS_ENCRYPTION_KEY={{openssl_rand_16}}
FORMBRICKS_CRON_SECRET={{openssl_rand_32}}

FORMBRICKS_DB_NAME=formbricks
FORMBRICKS_DB_USER=formbricks
FORMBRICKS_DB_PASSWORD={{password_32}}

# 1 disables the feature. Without SMTP set EMAIL_VERIFICATION_DISABLED=1 so the
# first account can sign in.
FORMBRICKS_EMAIL_VERIFICATION_DISABLED=1
FORMBRICKS_PASSWORD_RESET_DISABLED=1

# SMTP for invites, verification and email-based surveys. Replace with your provider.
FORMBRICKS_MAIL_FROM=formbricks@example.com
FORMBRICKS_MAIL_FROM_NAME=Formbricks
FORMBRICKS_SMTP_HOST=smtp.example.com
FORMBRICKS_SMTP_PORT=587
FORMBRICKS_SMTP_USER=formbricks@example.com
FORMBRICKS_SMTP_PASSWORD={{password_32}}
FORMBRICKS_SMTP_SECURE_ENABLED=0

FORMBRICKS_DB_HEALTHCHECK_INTERVAL=10s
FORMBRICKS_DB_HEALTHCHECK_TIMEOUT=5s
FORMBRICKS_DB_HEALTHCHECK_RETRIES=10
