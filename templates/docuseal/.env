# Used only by the commented host-port mapping in compose.yml.
DOCUSEAL_PORT=8080

# Public host (and optional port) users reach DocuSeal on. Baked into email links.
DOCUSEAL_HOST=localhost:8080
DOCUSEAL_FORCE_SSL=false
DOCUSEAL_SECRET_KEY_BASE={{openssl_rand_64}}

# Leave empty to use the bundled SQLite database at /data/docuseal.sqlite3.
# For PostgreSQL, uncomment the `db` service in compose.yml and set this to
# postgresql://docuseal:<password>@db:5432/docuseal
DOCUSEAL_DATABASE_URL=

# Used only by the bundled Postgres — ignore if you stay on SQLite.
DOCUSEAL_DB_NAME=docuseal
DOCUSEAL_DB_USER=docuseal
DOCUSEAL_DB_PASSWORD={{password_32}}
