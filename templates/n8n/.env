# Used only by the commented host-port mapping in compose.yml.
N8N_PORT=5678

# Public host and origin n8n is served from. WEBHOOK_URL must be the exact
# external URL — webhook and OAuth callback nodes build their URLs from it.
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_TIMEZONE=UTC

# Encrypts stored credentials. Losing or changing this orphans every saved
# credential. openssl rand -hex 32
N8N_ENCRYPTION_KEY={{openssl_rand_32}}

# Editor login. Disable only if n8n sits behind another auth layer.
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD={{password_12}}
