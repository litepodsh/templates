# "repo" registers against REPO_URL, "org" against ORG_NAME.
RUNNER_SCOPE=repo
REPO_URL=https://github.com/your-user/your-repo
ORG_NAME=
# Classic PAT with "repo" scope (repo runners) or "admin:org" (org runners).
ACCESS_TOKEN=replace-with-your-github-pat
RUNNER_NAME_PREFIX=litepod
LABELS=litepod,linux
# true = one job per registration, then the container restarts clean.
EPHEMERAL=true
