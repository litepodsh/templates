# API/ingestion endpoint. Change the host port if 8080 is already occupied.
RUSTRAK_SERVER_PORT=8080
# Browser dashboard.
RUSTRAK_UI_PORT=3000
# Used by the dashboard container to reach the API.
RUSTRAK_API_URL=http://server:8080
# Replace these placeholders before deploying; do not commit real credentials.
RUSTRAK_SESSION_SECRET_KEY=replace-with-a-64-character-random-hex-string
RUSTRAK_CREATE_SUPERUSER=admin@example.com:replace-with-a-strong-password
