# Used only by the commented host-port mapping in compose.yml.
OUTLINE_PORT=3000

# Public URL Outline is served from — must be the exact external origin.
OUTLINE_URL=http://localhost:3000
OUTLINE_FORCE_HTTPS=false

# openssl rand -hex 32  for each.
OUTLINE_SECRET_KEY={{openssl_rand_32}}
OUTLINE_UTILS_SECRET={{openssl_rand_32}}

OUTLINE_DB_NAME=outline
OUTLINE_DB_USER=outline
OUTLINE_DB_PASSWORD={{password_32}}

# Bytes. 26214400 = 25 MiB.
OUTLINE_UPLOAD_MAX_SIZE=26214400

# --- Authentication: configure at least one provider (see setup.md) ---
# OIDC (generic). Leave blank to use GOOGLE_/SLACK_/AZURE_ vars instead.
OUTLINE_OIDC_CLIENT_ID=
OUTLINE_OIDC_CLIENT_SECRET=
OUTLINE_OIDC_AUTH_URI=
OUTLINE_OIDC_TOKEN_URI=
OUTLINE_OIDC_USERINFO_URI=
OUTLINE_OIDC_USERNAME_CLAIM=preferred_username
OUTLINE_OIDC_DISPLAY_NAME=SSO
OUTLINE_OIDC_SCOPES=openid profile email

# SMTP — optional, enables invite and notification emails.
OUTLINE_SMTP_HOST=
OUTLINE_SMTP_PORT=587
OUTLINE_SMTP_USERNAME=
OUTLINE_SMTP_PASSWORD=
OUTLINE_SMTP_FROM_EMAIL=outline@example.com

OUTLINE_DB_HEALTHCHECK_INTERVAL=10s
OUTLINE_DB_HEALTHCHECK_TIMEOUT=5s
OUTLINE_DB_HEALTHCHECK_RETRIES=10
