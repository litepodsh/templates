# Used only by the commented host-port mapping in compose.yml.
SEAFILE_PORT=80

# Seafile public address (host only — LitePod resolves this).
SEAFILE_SERVER_HOSTNAME={{domain}}
# Protocol Seafile advertises for generated links. Keep http for generated
# domains; set to https once you attach a domain with a certificate.
SEAFILE_SERVER_PROTOCOL=http

# First admin account (the login is the email). Change the email.
INIT_SEAFILE_ADMIN_EMAIL=admin@example.com
INIT_SEAFILE_ADMIN_PASSWORD={{password_24_readable}}

# MariaDB credentials — internal, talk over the Compose network.
INIT_SEAFILE_MYSQL_ROOT_PASSWORD={{password_32}}
SEAFILE_MYSQL_DB_USER=seafile
SEAFILE_MYSQL_DB_PASSWORD={{password_32}}
SEAFILE_MYSQL_DB_CCNET_DB_NAME=ccnet_db
SEAFILE_MYSQL_DB_SEAFILE_DB_NAME=seafile_db
SEAFILE_MYSQL_DB_SEAHUB_DB_NAME=seahub_db

# JWT signing key — needs >= 32 random chars.
JWT_PRIVATE_KEY={{openssl_rand_32}}

TIME_ZONE=Etc/UTC

# Cache — Redis is the default since Seafile 13.
CACHE_PROVIDER=redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
