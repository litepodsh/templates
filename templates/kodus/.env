# Public addresses. Kodus registers repository webhooks with KODUS_WEBHOOKS_URL when you
# connect a Git provider, so put your final domain on the webhooks port before connecting.
KODUS_URL={{url}}
KODUS_WEBHOOKS_URL={{url:3332}}

# LLM. Leave the key empty to add your own provider later in the web app (BYOK), or set an
# OpenAI key here. For an OpenAI-compatible endpoint, also set OPENAI_BASE_URL and pick a
# model in KODUS_LLM_MODEL ("auto" lets Kodus choose per task).
OPENAI_API_KEY=
OPENAI_BASE_URL=
KODUS_LLM_MODEL=auto
# Reasoning models that only accept temperature 1 (o1, kimi-k2-thinking) need this set to 1.
KODUS_LLM_TEMPERATURE_OVERRIDE=

# Email for invites and reports: resend or smtp. Without either, invites aren't delivered.
KODUS_EMAIL_PROVIDER=smtp
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com

# error, warn, info or debug
KODUS_LOG_LEVEL=error
# true opts into features Kodus has shipped to its cloud but not yet marked stable.
KODUS_BETA_FEATURES=false
# true stops the daily anonymous usage heartbeat to telemetry.kodus.io.
KODUS_TELEMETRY_DISABLED=false

# Secrets, generated once when the app is created.
KODUS_JWT_SECRET={{base64_32}}
KODUS_JWT_REFRESH_SECRET={{base64_32}}
KODUS_CRYPTO_KEY={{openssl_rand_32}}
KODUS_NEXTAUTH_SECRET={{base64_32}}
KODUS_CODE_MANAGEMENT_SECRET={{openssl_rand_32}}
KODUS_WEBHOOK_TOKEN={{base64url_32}}

# Internal databases and broker.
KODUS_PG_USER=kodus
KODUS_PG_PASSWORD={{openssl_rand_32}}
KODUS_PG_DATABASE=kodus_db
KODUS_MONGO_USER=kodus
KODUS_MONGO_PASSWORD={{openssl_rand_32}}
KODUS_MONGO_DATABASE=kodus_db
KODUS_RABBITMQ_USER=kodus
KODUS_RABBITMQ_PASSWORD={{password_32}}
