# Used only by the commented host-port mapping in compose.yml.
IMMICH_PORT=2283

IMMICH_TZ=Etc/UTC

IMMICH_DB_NAME=immich
IMMICH_DB_USER=immich
# Use only A-Za-z0-9 here — some characters break the Postgres connection string.
IMMICH_DB_PASSWORD={{password_32}}

IMMICH_DB_HEALTHCHECK_INTERVAL=10s
IMMICH_DB_HEALTHCHECK_TIMEOUT=5s
IMMICH_DB_HEALTHCHECK_RETRIES=10
