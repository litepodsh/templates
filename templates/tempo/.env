# Used only by the commented host-port mappings in compose.yml.
TEMPO_PORT=3200
TEMPO_OTLP_GRPC_PORT=4317
TEMPO_OTLP_HTTP_PORT=4318

TEMPO_LOG_LEVEL=info

# How long completed blocks are kept before compaction drops them. 336h = 14d.
TEMPO_BLOCK_RETENTION=336h

# Widest time range a single TraceQL metrics query may cover.
TEMPO_METRICS_MAX_DURATION=24h

# Tempo's built-in MCP server, for LLM-driven trace exploration.
TEMPO_MCP_SERVER_ENABLED=true
