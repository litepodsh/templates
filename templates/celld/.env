# Host port for the public Worker listener.
CELLD_PORT=8080

# Fleet bucket (optional key prefix: s3://bucket/prefix). Must support
# conditional writes: Amazon S3, Cloudflare R2, Tigris or GCS qualify.
CELLD_BUCKET=s3://change-me
# S3-compatible endpoint, e.g. https://ACCOUNT_ID.r2.cloudflarestorage.com.
# Leave empty for Amazon S3.
S3_ENDPOINT=
# Storage region; use "auto" for Cloudflare R2.
AWS_REGION=auto
# Bucket credentials. They give full control of the fleet; set at deploy time.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Seconds between checks for a new `celld deploy`.
CELLD_DEPLOY_POLL_S=30
