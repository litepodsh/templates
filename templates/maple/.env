# Sent by your applications' OTLP exporters as a Bearer token. It can write telemetry, never read it.
MAPLE_LOCAL_INGEST_KEY={{openssl_rand_32}}
# Signs in to the dashboard and authorizes the query API and CLI. Everyone shares it.
MAPLE_LOCAL_ACCESS_TOKEN={{openssl_rand_32}}
# Set to "off" to stop Maple sending its own traces and metrics to Maple. Your telemetry never leaves the server.
MAPLE_TELEMETRY=
