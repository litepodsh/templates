PLAUSIBLE_PORT=8000
PLAUSIBLE_BASE_URL=http://localhost:8000
PLAUSIBLE_SECRET_KEY_BASE={{openssl_rand_64}}
PLAUSIBLE_DISABLE_REGISTRATION=invite_only
PLAUSIBLE_DB_NAME=plausible_db
PLAUSIBLE_DB_USER=plausible
PLAUSIBLE_DB_PASSWORD={{password_32}}
PLAUSIBLE_CLICKHOUSE_DB_NAME=plausible_events_db
PLAUSIBLE_CLICKHOUSE_SKIP_USER_SETUP=1
PLAUSIBLE_DB_HEALTHCHECK_INTERVAL=10s
PLAUSIBLE_DB_HEALTHCHECK_TIMEOUT=5s
PLAUSIBLE_DB_HEALTHCHECK_RETRIES=10
PLAUSIBLE_CLICKHOUSE_HEALTHCHECK_INTERVAL=10s
PLAUSIBLE_CLICKHOUSE_HEALTHCHECK_TIMEOUT=5s
PLAUSIBLE_CLICKHOUSE_HEALTHCHECK_RETRIES=10
