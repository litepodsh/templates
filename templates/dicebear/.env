# Request logging (1 = enabled, 0 = disabled).
DICEBEAR_LOGGER=0

# Node.js worker threads and supported DiceBear major versions.
DICEBEAR_WORKERS=1
DICEBEAR_VERSIONS=10

# HTTP cache durations in seconds.
DICEBEAR_CACHE_CONTROL_AVATARS=31536000
DICEBEAR_CACHE_CONTROL_STYLES=3600

# PNG output settings (1 = enabled, 0 = disabled).
DICEBEAR_PNG=1
DICEBEAR_PNG_SIZE_MIN=1
DICEBEAR_PNG_SIZE_MAX=256
DICEBEAR_PNG_SIZE_DEFAULT=128
DICEBEAR_PNG_EXIF=1

# Optional per-style metadata endpoints (1 = enabled, 0 = disabled).
DICEBEAR_DEFINITION=0
DICEBEAR_OPTIONS=0
