# Public origins. The browser calls the api directly, so both need a domain.
ITSAPLAN_APP_URL={{url}}
ITSAPLAN_API_URL={{url:3000}}
# Optional. Overrides the cookie domain derived from APP_URL (e.g. .example.com).
ITSAPLAN_COOKIE_DOMAIN=

ITSAPLAN_BETTER_AUTH_SECRET={{base64_32}}
# Encrypts stored provider credentials. Changing it makes them undecryptable.
ITSAPLAN_APP_ENCRYPTION_KEY={{base64_32}}

ITSAPLAN_DB_NAME=itsaplan
ITSAPLAN_DB_USER=itsaplan
ITSAPLAN_DB_PASSWORD={{password_32}}

# RustFS root credentials, also used by the api to store attachments.
ITSAPLAN_S3_ACCESS_KEY_ID=itsaplan
ITSAPLAN_S3_SECRET_ACCESS_KEY={{password_32}}
ITSAPLAN_S3_BUCKET=planner-attachments
ITSAPLAN_S3_REGION=us-east-1

# Optional. Comma-separated hosts trusted even though they resolve privately
# (e.g. a self-hosted Gitea). Read by the api and the worker.
ITSAPLAN_SSRF_ALLOWED_HOSTS=
# Optional. Legal document URLs on the logged-out screens; empty hides the notice.
ITSAPLAN_PRIVACY_URL=
ITSAPLAN_TERMS_URL=
# Set to 1 to turn off anonymous telemetry.
ITSAPLAN_TELEMETRY_DISABLED=
# Days the pre-migration database dumps are kept.
ITSAPLAN_BACKUP_RETENTION_DAYS=30
