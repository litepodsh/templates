PLANE_URL={{url}}
PLANE_DOMAIN={{domain}}
PLANE_S3_PUBLIC_URL={{url:9000}}

PLANE_SECRET_KEY={{password_50}}
PLANE_LIVE_SECRET_KEY={{password_50}}

PLANE_DB_NAME=plane
PLANE_DB_USER=plane
PLANE_DB_PASSWORD={{password_32}}
PLANE_DB_MAX_CONNECTIONS=1000

PLANE_REDIS_PASSWORD={{password_32}}

PLANE_MQ_USER=plane
PLANE_MQ_PASSWORD={{password_32}}
PLANE_MQ_VHOST=plane

PLANE_S3_ACCESS_KEY={{password_20}}
PLANE_S3_SECRET_KEY={{password_40}}
PLANE_S3_BUCKET=uploads
PLANE_S3_REGION=us-east-1

# Maximum upload size in bytes (default 5 MB).
PLANE_FILE_SIZE_LIMIT=5242880
