# Used only by the commented host-port mapping in compose.yml.
OPENPANEL_PORT=3000

# Dashboard and API live on separate domains. The session cookie is set on the
# dashboard's parent domain (analytics.example.com -> .example.com), so put both
# under the same parent domain (see setup.md).
OPENPANEL_DASHBOARD_URL={{url}}
OPENPANEL_API_URL={{url:3001}}

OPENPANEL_COOKIE_SECRET={{openssl_rand_16}}

# The first account can always sign up; after that only invites work unless
# registration is enabled.
OPENPANEL_ALLOW_REGISTRATION=false
OPENPANEL_ALLOW_INVITATION=true

# Optional. Invites and password resets are sent through Resend.
OPENPANEL_EMAIL_SENDER=
OPENPANEL_RESEND_API_KEY=

OPENPANEL_DB_NAME=openpanel
OPENPANEL_DB_USER=openpanel
OPENPANEL_DB_PASSWORD={{password_32}}
OPENPANEL_REDIS_PASSWORD={{password_32}}

# Events are buffered in Redis and flushed to ClickHouse in batches.
OPENPANEL_BATCH_SIZE=5000
OPENPANEL_BATCH_INTERVAL=10000
