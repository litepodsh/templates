# Used only by the commented host-port mappings in compose.yml.
GARAGE_WEBUI_PORT=3909
GARAGE_S3_PORT=3900
GARAGE_ADMIN_PORT=3903

# Cluster RPC secret — must be a 32-byte hex string (64 hex chars).
GARAGE_RPC_SECRET={{openssl_rand_32}}
# Bearer tokens for the admin and metrics endpoints.
GARAGE_ADMIN_TOKEN={{openssl_rand_32}}
GARAGE_METRICS_TOKEN={{openssl_rand_32}}

# S3 region name clients must use.
GARAGE_REGION=garage
# Wildcard domains for virtual-hosted-style buckets and the static web endpoint.
GARAGE_S3_ROOT_DOMAIN=.s3.garage.localhost
GARAGE_WEB_ROOT_DOMAIN=.web.garage.localhost

# Web UI login, "user:password".
GARAGE_WEBUI_AUTH_USER_PASS=admin:{{password_32}}
