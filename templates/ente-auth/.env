# Used only by the commented host-port mappings in compose.yml.
ENTE_WEB_PORT=3003
ENTE_API_PORT=8080

# Public origin that browsers and the mobile/desktop Auth apps use to reach
# museum. Must be the complete URL, without a trailing slash.
ENTE_API_ORIGIN={{url:8080}}

# --- Crypto secrets: generated automatically by Litepod on deployment ---
# The placeholder sizes are random bytes before Base64 encoding.
# Losing them makes existing accounts unrecoverable.
ENTE_KEY_ENCRYPTION={{base64_32}}
ENTE_KEY_HASH={{base64_64}}
ENTE_JWT_SECRET={{base64url_32}}

ENTE_DB_NAME=ente
ENTE_DB_USER=ente
ENTE_DB_PASSWORD={{password_32}}

# SMTP — optional. Without it, sign-up / login OTP codes are printed to the
# museum container log instead of emailed.
ENTE_SMTP_HOST=
ENTE_SMTP_PORT=587
ENTE_SMTP_USERNAME=
ENTE_SMTP_PASSWORD=
ENTE_SMTP_EMAIL=ente@example.com

ENTE_DB_HEALTHCHECK_INTERVAL=10s
ENTE_DB_HEALTHCHECK_TIMEOUT=5s
ENTE_DB_HEALTHCHECK_RETRIES=10
