HARNESS_URL={{url}}
HARNESS_DOMAIN={{domain}}
HARNESS_SSH_PORT=3022
# Sign in with user "admin" or this email. Used to create the admin on first boot only.
HARNESS_ADMIN_EMAIL=admin@example.com
HARNESS_ADMIN_PASSWORD={{password_24_readable}}
# Anyone who can reach the instance could create an account when this is true.
HARNESS_USER_SIGNUP_ENABLED=false
HARNESS_PUBLIC_RESOURCE_CREATION_ENABLED=false
# Upstream's default is true, which sends usage metrics to stats.drone.ci.
HARNESS_METRIC_ENABLED=false
# Gitspaces are off: their IDE ports stay inside docker-in-docker, unreachable from a browser.
HARNESS_GITSPACE_ENABLE=false
# Pipelines run in parallel. Each extra worker needs roughly another full set of the limits below.
HARNESS_CI_PARALLEL_WORKERS=1
# Hard cap for ALL pipeline containers combined. Size it to leave room for your other apps.
JOBS_CPU_LIMIT=2.0
JOBS_MEMORY_LIMIT=4g
