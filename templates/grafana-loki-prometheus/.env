GRAFANA_ROOT_URL=https://grafana.example.com/
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD={{password_12}}
GRAFANA_ALLOW_SIGN_UP=false

# Used only by the commented host-port mappings in compose.yml.
GRAFANA_PORT=3000
LOKI_PORT=3100
PROMETHEUS_PORT=9090

PROMETHEUS_RETENTION_TIME=15d

PROMETHEUS_HEALTHCHECK_INTERVAL=30s
PROMETHEUS_HEALTHCHECK_TIMEOUT=10s
PROMETHEUS_HEALTHCHECK_RETRIES=5
PROMETHEUS_HEALTHCHECK_START_PERIOD=30s
