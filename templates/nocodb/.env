# NocoDB listens on 8080.
NOCODB_PORT=8080

# Point NC_DB at any Postgres. Default targets the bundled `db` service defined
# (commented out) in compose.yml. Uncomment the service there to use it, or
# change this URL to an existing instance.
NC_DB=pg://nocodb:ch4ng3m3@db:5432/nocodb
NC_DB_HOST=db
NC_DB_PORT=5432
NC_DB_NAME=nocodb
NC_DB_USER=nocodb
NC_DB_PASS=ch4ng3m3

# Used only by the bundled Postgres — safe to ignore if you point at an external DB.
POSTGRES_DB=nocodb
POSTGRES_USER=nocodb
POSTGRES_PASSWORD=ch4ng3m3

NC_AUTH_JWT_SECRET=ch4ng3m3
NC_PUBLIC_URL=http://localhost:8080
