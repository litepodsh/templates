# Used only by the commented host-port mapping in compose.yml.
INVOICENINJA_PORT=8080

# Public URL Invoice Ninja is served from — baked into invoice/portal links.
INVOICENINJA_APP_URL=http://localhost:8080
INVOICENINJA_APP_DEBUG=false
INVOICENINJA_REQUIRE_HTTPS=false

# REQUIRED. Generate before first start (see setup.md) and paste the full value
# including the "base64:" prefix. Changing it later makes encrypted data
# unreadable.
INVOICENINJA_APP_KEY=

# First admin account, created on first boot.
INVOICENINJA_ADMIN_EMAIL=admin@example.com
INVOICENINJA_ADMIN_PASSWORD={{password_12}}

INVOICENINJA_DB_NAME=ninja
INVOICENINJA_DB_USER=ninja
INVOICENINJA_DB_PASSWORD={{password_32}}
INVOICENINJA_DB_ROOT_PASSWORD={{password_32}}

# Mail — "log" writes emails to the container log. Switch to "smtp" and fill the
# rest to actually send invoices.
INVOICENINJA_MAIL_MAILER=log
INVOICENINJA_MAIL_HOST=smtp.example.com
INVOICENINJA_MAIL_PORT=587
INVOICENINJA_MAIL_USERNAME=
INVOICENINJA_MAIL_PASSWORD=
INVOICENINJA_MAIL_ENCRYPTION=tls
INVOICENINJA_MAIL_FROM_ADDRESS=invoiceninja@example.com
INVOICENINJA_MAIL_FROM_NAME="Invoice Ninja"

INVOICENINJA_DB_HEALTHCHECK_INTERVAL=10s
INVOICENINJA_DB_HEALTHCHECK_TIMEOUT=5s
INVOICENINJA_DB_HEALTHCHECK_RETRIES=10
