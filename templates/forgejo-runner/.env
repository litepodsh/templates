# Your Forgejo instance, e.g. https://git.example.com
FORGEJO_URL=https://git.example.com
# From Forgejo → Settings → Actions → Runners → "Create new runner".
RUNNER_UUID=replace-with-runner-uuid
RUNNER_TOKEN=replace-with-runner-token
# Comma-separated "name:docker://image" pairs; workflows pick one with runs-on.
RUNNER_LABELS=docker:docker://data.forgejo.org/oci/node:22-bookworm,ubuntu-latest:docker://data.forgejo.org/oci/node:22-bookworm
# Jobs run in parallel. Each extra slot needs roughly another full set of the limits below.
RUNNER_CAPACITY=1
# Hard cap for ALL job containers combined. Size it to leave room for your other apps.
JOBS_CPU_LIMIT=2.0
JOBS_MEMORY_LIMIT=4g
