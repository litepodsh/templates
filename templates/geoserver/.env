# Used only by the commented host-port mapping in compose.yml.
GEOSERVER_PORT=8080

# Change BOTH before first boot — geoserver/admin is a well-known default.
GEOSERVER_ADMIN_USER=admin
GEOSERVER_ADMIN_PASSWORD={{password_32}}

GEOSERVER_SKIP_DEMO_DATA=true
GEOSERVER_CORS_ENABLED=true

# Space-separated extension names to fetch at startup, e.g. "wps css".
GEOSERVER_INSTALL_EXTENSIONS=false
GEOSERVER_STABLE_EXTENSIONS=

# Public base URL of the admin UI / OGC endpoints, e.g. https://gis.example.com/geoserver
GEOSERVER_PROXY_BASE_URL=http://localhost:8080/geoserver
