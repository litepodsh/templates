CHATWOOT_VERSION=v4.18.0
CHATWOOT_PGVECTOR_VERSION=0.8.7-pg16
CHATWOOT_REDIS_VERSION=8-alpine

CHATWOOT_FRONTEND_URL={{url}}
CHATWOOT_SECRET_KEY_BASE={{openssl_rand_64}}
CHATWOOT_FORCE_SSL=false
CHATWOOT_ENABLE_ACCOUNT_SIGNUP=false
CHATWOOT_DEFAULT_LOCALE=en
CHATWOOT_LOG_LEVEL=info
CHATWOOT_RAILS_MAX_THREADS=5

CHATWOOT_DB_NAME=chatwoot
CHATWOOT_DB_USER=chatwoot
CHATWOOT_DB_PASSWORD={{password_32}}
CHATWOOT_REDIS_PASSWORD={{password_32}}

CHATWOOT_MAILER_SENDER_EMAIL=Chatwoot <no-reply@example.com>
CHATWOOT_SMTP_ADDRESS=
CHATWOOT_SMTP_PORT=587
CHATWOOT_SMTP_DOMAIN=example.com
CHATWOOT_SMTP_USERNAME=
CHATWOOT_SMTP_PASSWORD=
CHATWOOT_SMTP_AUTHENTICATION=login
CHATWOOT_SMTP_ENABLE_STARTTLS_AUTO=true
