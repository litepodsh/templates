# Host port for the API, /playground and /mcp.
CRAWL4AI_PORT=11235

# Bearer token required on API calls.
CRAWL4AI_API_TOKEN={{password_32}}
# Allow deep (multi-page) crawling through the API.
CRAWL4AI_ALLOW_DEEP_CRAWL=false
# Chromium is memory hungry; raise for heavy concurrent crawls.
CRAWL4AI_MEMORY_LIMIT=4g

# Optional: LLM extraction. Leave empty to disable.
CRAWL4AI_OPENAI_API_KEY=
CRAWL4AI_ANTHROPIC_API_KEY=
CRAWL4AI_GEMINI_API_KEY=
# Default provider, e.g. "anthropic/claude-sonnet-4-5".
CRAWL4AI_LLM_PROVIDER=
