############
# Host ports
############
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443
STUDIO_PORT=3000
DB_PORT=5432

############################
# Secrets — REPLACE in prod
############################
# Postgres superuser password. Also used by supabase_auth_admin / supabase_storage_admin.
POSTGRES_PASSWORD={{password_32}}
# JWT secret used by PostgREST, GoTrue, Realtime, Storage, and Edge Functions.
# 32+ random bytes; rotate after leaks.
JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
# Placeholder keys. Generate proper ones against JWT_SECRET before exposing.
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.placeholder.changeme
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.placeholder.changeme
# Phoenix signing salt for Realtime. 64+ random characters.
SECRET_KEY_BASE={{openssl_rand_32}}
# Encrypts connection strings stored by postgres-meta / Studio.
PG_META_CRYPTO_KEY={{openssl_rand_16}}
# Encrypts Realtime's tenant records.
REALTIME_DB_ENC_KEY=supabaserealtime

######################
# Database connection
######################
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=postgres

###############################
# Public URLs / signing
###############################
SITE_URL=http://localhost:3000
API_EXTERNAL_URL=http://localhost:8000
SUPABASE_PUBLIC_URL=http://localhost:8000
ADDITIONAL_REDIRECT_URLS=
JWT_EXPIRY=3600
DEFAULT_ORGANIZATION_NAME=Default
DEFAULT_PROJECT_NAME=Default

########
# Auth
########
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
# Skip the confirmation mail and mark new sign-ups as verified. Handy without SMTP.
ENABLE_EMAIL_AUTOCONFIRM=false
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false

########
# REST
########
PGRST_DB_SCHEMAS=public,storage,graphql_public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public

##########
# Storage
##########
STORAGE_FILE_SIZE_LIMIT=52428800
# Bucket name on disk when STORAGE_BACKEND=file.
GLOBAL_S3_BUCKET=stub
STORAGE_TENANT_ID=stub
REGION=stub
# Credentials for storage's S3-compatible protocol endpoint.
S3_PROTOCOL_ACCESS_KEY_ID=
S3_PROTOCOL_ACCESS_KEY_SECRET=
IMGPROXY_AUTO_WEBP=true

####################
# Edge Functions
####################
FUNCTIONS_VERIFY_JWT=true

####################
# OAuth providers
####################
ENABLE_GOOGLE_SIGNIN=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ENABLE_GITHUB_SIGNIN=false
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

########
# SMTP
########
# Point at Mailpit (in this catalog) or any external SMTP for dev/prod.
SMTP_ADMIN_EMAIL=admin@localhost
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=mailpit
SMTP_PASS=ch4ng3m3
SMTP_SENDER_NAME=Supabase
MAILER_URLPATHS_INVITE=/auth/v1/verify
MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
MAILER_URLPATHS_RECOVERY=/auth/v1/verify
MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify

###############
# Kong admin UI
###############
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD={{password_12}}
