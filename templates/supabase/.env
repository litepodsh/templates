############################
# Secrets — replace in prod
############################
POSTGRES_PASSWORD={{password_32}}
JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.placeholder.changeme
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.placeholder.changeme
PG_META_CRYPTO_KEY={{openssl_rand_16}}
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD={{password_12}}

####################
# Internal services
####################
KONG_DATABASE=off
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=postgres

###############################
# Public URLs / Studio defaults
###############################
SITE_URL=https://app.example.com
API_EXTERNAL_URL=https://api.example.com
SUPABASE_PUBLIC_URL=https://api.example.com
ADDITIONAL_REDIRECT_URLS=
JWT_EXPIRY=3600
DEFAULT_ORGANIZATION_NAME=Default
DEFAULT_PROJECT_NAME=Default

########
# Auth
########
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false

########
# REST
########
PGRST_DB_SCHEMAS=public,graphql_public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public

########
# SMTP
########
SMTP_ADMIN_EMAIL=admin@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=Supabase
MAILER_URLPATHS_INVITE=/auth/v1/verify
MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
MAILER_URLPATHS_RECOVERY=/auth/v1/verify
MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify
