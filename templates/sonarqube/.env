# Used only by the commented host-port mapping in compose.yml.
SONARQUBE_PORT=9000

SONARQUBE_DB_NAME=sonar
SONARQUBE_DB_USER=sonar
SONARQUBE_DB_PASSWORD={{password_32}}

SONARQUBE_HEALTHCHECK_INTERVAL=30s
SONARQUBE_HEALTHCHECK_TIMEOUT=10s
SONARQUBE_HEALTHCHECK_RETRIES=10
SONARQUBE_HEALTHCHECK_START_PERIOD=120s

SONARQUBE_DB_HEALTHCHECK_INTERVAL=10s
SONARQUBE_DB_HEALTHCHECK_TIMEOUT=5s
SONARQUBE_DB_HEALTHCHECK_RETRIES=10
