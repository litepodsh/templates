# Fully-qualified hostname of this mail server. Must match its A record and the
# PTR (reverse DNS) of the public IP, and be the name used in the MX record.
POSTEIO_HOSTNAME=mail.example.com

# Host ports for the admin UI / webmail. The mail ports (25, 465, 587, 993, …)
# are fixed by protocol and mapped 1:1 in compose.yml.
POSTEIO_HTTP_PORT=8080
POSTEIO_HTTPS_PORT=8443

POSTEIO_TZ=Etc/UTC
POSTEIO_HTTPS=OFF
POSTEIO_DISABLE_CLAMAV=FALSE
POSTEIO_DISABLE_RSPAMD=FALSE
