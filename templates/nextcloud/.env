# Used only by the commented host-port mapping in compose.yml.
NEXTCLOUD_PORT=80

# Public host Nextcloud is served from. LitePod resolves this to the domain of
# the primary port; space-separate to add more trusted domains.
NEXTCLOUD_TRUSTED_DOMAINS={{domain}}

# Canonical public URL (scheme + host), used for generated links and cron.
NEXTCLOUD_OVERWRITE_CLI_URL={{url}}

# First admin account, created automatically on first boot.
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD={{password_24_readable}}

NEXTCLOUD_DB_NAME=nextcloud
NEXTCLOUD_DB_USER=nextcloud
# Use only A-Za-z0-9 here — some characters break the Postgres connection string.
NEXTCLOUD_DB_PASSWORD={{password_32}}

# PHP limits. 10G allows large file uploads.
NEXTCLOUD_PHP_MEMORY_LIMIT=512M
NEXTCLOUD_PHP_UPLOAD_LIMIT=10G

NEXTCLOUD_DB_HEALTHCHECK_INTERVAL=10s
NEXTCLOUD_DB_HEALTHCHECK_TIMEOUT=5s
NEXTCLOUD_DB_HEALTHCHECK_RETRIES=10
