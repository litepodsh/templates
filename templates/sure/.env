# Used only by the commented host-port mapping in compose.yml.
SURE_PORT=3000

# Host used to build links in emails (no scheme).
SURE_APP_DOMAIN={{domain}}
SURE_SECRET_KEY_BASE={{openssl_rand_64}}

# Who can sign up: open, closed or invite_only. Close it after creating your account.
SURE_ONBOARDING_STATE=open

# LitePod's proxy terminates TLS. Set both to true only when the app is always served over https.
SURE_RAILS_FORCE_SSL=false
SURE_RAILS_ASSUME_SSL=false

SURE_DB_NAME=sure_production
SURE_DB_USER=sure_user
SURE_DB_PASSWORD={{password_32}}

# Optional. Needed for password resets, invites and email reports.
SURE_SMTP_ADDRESS=
SURE_SMTP_PORT=465
SURE_SMTP_USERNAME=
SURE_SMTP_PASSWORD=
SURE_SMTP_TLS_ENABLED=true
SURE_EMAIL_SENDER=

# Optional. Enables the AI chat and auto-categorization rules.
# OPENAI_URI_BASE accepts any OpenAI-compatible endpoint (Ollama, LM Studio, ...).
SURE_OPENAI_ACCESS_TOKEN=
SURE_OPENAI_MODEL=
SURE_OPENAI_URI_BASE=
