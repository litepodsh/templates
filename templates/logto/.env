LOGTO_VERSION=1.44.0
LOGTO_HTTP_PORT=3001
LOGTO_ADMIN_PORT=3002
# Public URLs (scheme + host[:port]). Behind a proxy, e.g.
# https://auth.example.com and https://auth-admin.example.com.
LOGTO_ENDPOINT=http://localhost:3001
LOGTO_ADMIN_ENDPOINT=http://localhost:3002

LOGTO_DB_NAME=logto
LOGTO_DB_USER=logto
LOGTO_DB_PASSWORD={{password_32}}
