# Used only by the commented host-port mapping in compose.yml.
STIRLING_PDF_PORT=8080

# false keeps OCR, PDF-to-image and other Python/LibreOffice-backed tools on.
STIRLING_PDF_DISABLE_ADDITIONAL_FEATURES=false

# Set true to enable the login system (see setup.md), then create the first
# account with the credentials below on first start.
STIRLING_PDF_ENABLE_SECURITY=false

# OCR language packs to download at build time, space-separated (e.g. "en_GB de_DE").
STIRLING_PDF_LANGS=en_GB
STIRLING_PDF_LOCALE=en-US

STIRLING_PDF_HEALTHCHECK_INTERVAL=30s
STIRLING_PDF_HEALTHCHECK_TIMEOUT=5s
STIRLING_PDF_HEALTHCHECK_RETRIES=5
