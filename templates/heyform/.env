# Used only by the commented host-port mapping in compose.yml.
HEYFORM_PORT=8000

# Public URL HeyForm is served from. A wrong value causes login redirect loops —
# see setup.md for the local / LAN / public rules.
HEYFORM_APP_HOMEPAGE_URL=http://localhost:8000

HEYFORM_SESSION_KEY={{openssl_rand_32}}
# Exactly 32 characters.
HEYFORM_FORM_ENCRYPTION_KEY={{password_32}}

HEYFORM_DB_NAME=heyform
