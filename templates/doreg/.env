# Used only by the commented host-port mapping in compose.yml.
DOREG_PORT=8080

# Admin created on first start, only if the database has no users yet.
DOREG_ADMIN_USER=admin
DOREG_ADMIN_PASSWORD={{password_32}}

# Show public repositories in the web UI without signing in.
DOREG_PUBLIC_BROWSE=false

# Allow webhook URLs on private / loopback networks.
DOREG_WEBHOOK_ALLOW_PRIVATE=false
