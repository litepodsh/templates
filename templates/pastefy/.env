PASTEFY_PORT=8080
PASTEFY_CONTAINER_PORT=80
PASTEFY_SERVER_NAME=http://localhost:8080
PASTEFY_CORS_ORIGINS=*
PASTEFY_DATABASE_DRIVER=mysql
PASTEFY_DATABASE_NAME=pastefy
PASTEFY_DATABASE_USER=pastefy
# Replace both database passwords before deployment.
PASTEFY_DATABASE_PASSWORD=replace-with-a-long-unique-password
PASTEFY_MYSQL_ROOT_PASSWORD=replace-with-a-different-long-unique-password
PASTEFY_DATABASE_HOST=db
PASTEFY_DATABASE_PORT=3306
PASTEFY_AUTOMIGRATE=true
PASTEFY_AUTH_PROVIDER=NONE
PASTEFY_DATABASE_HEALTHCHECK_INTERVAL=10s
PASTEFY_DATABASE_HEALTHCHECK_TIMEOUT=5s
PASTEFY_DATABASE_HEALTHCHECK_RETRIES=10
PASTEFY_DATABASE_HEALTHCHECK_START_PERIOD=30s
