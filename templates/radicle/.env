RADICLE_DOMAIN={{domain}}
RADICLE_P2P_PORT=8776
# Your node's public name. No spaces, 32 bytes at most, so a generated domain doesn't fit.
RADICLE_ALIAS=litepod-seed
# "block" only replicates repositories you choose. "allow" replicates everything it finds on the network, which can fill your disk.
RADICLE_SEEDING_POLICY=block
