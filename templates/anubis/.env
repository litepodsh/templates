##############
# Host port
##############
# Public HTTP port for Anubis. litepod domains route to Anubis internally on 8923.
ANUBIS_PORT=8923

######################
# Public site and proxy
######################
# Hostname connected to the Anubis service in litepod, WITHOUT scheme or port.
# DO NOT add https:// or http:// — bare hostname only (e.g. app.example.com).
# Compose uses it for both Anubis cookies and permitted post-challenge redirects.
ANUBIS_PUBLIC_DOMAIN=localhost
# The website Anubis protects. Replace this placeholder before going public
# (see setup.md):
#   - litepod app on the same server: http://<runtime-name>-<service>:<internal-port>
#   - website hosted elsewhere:       https://origin.example.com
ANUBIS_TARGET=http://my-site-a1b2c3-web:3000

########################
# Challenge and logging
########################
ANUBIS_BIND=:8923
ANUBIS_DIFFICULTY=4
ANUBIS_SLOG_LEVEL=INFO
# Direct local Compose requests have no reverse-proxy headers.
# Use true for standalone podman compose, false behind litepod Caddy.
ANUBIS_USE_REMOTE_ADDRESS=true

#############################
# Internal metrics and health
#############################
# Port 9090 is exposed only to the Compose/litepod networks; it is not published on the host.
ANUBIS_METRICS_BIND=:9090


COOKIE_DOMAIM=mydomain.com
