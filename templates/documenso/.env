# Used only by the commented host-port mapping in compose.yml.
DOCUMENSO_PORT=3000

# Public URL Documenso is served from. Baked into signing links and emails.
DOCUMENSO_WEBAPP_URL=http://localhost:3000

DOCUMENSO_NEXTAUTH_SECRET={{openssl_rand_32}}
# Both keys must be at least 32 characters. Losing them makes stored secrets
# (2FA, API tokens) unrecoverable.
DOCUMENSO_ENCRYPTION_KEY={{openssl_rand_32}}
DOCUMENSO_ENCRYPTION_SECONDARY_KEY={{openssl_rand_32}}

# Passphrase of the .p12 signing certificate placed in the documenso_data
# volume at /opt/documenso/cert.p12 (see setup.md).
DOCUMENSO_SIGNING_PASSPHRASE=

DOCUMENSO_DISABLE_SIGNUP=false

DOCUMENSO_DB_NAME=documenso
DOCUMENSO_DB_USER=documenso
DOCUMENSO_DB_PASSWORD={{password_32}}

# SMTP is required to send signing invitations. Replace with your provider.
DOCUMENSO_SMTP_TRANSPORT=smtp-auth
DOCUMENSO_SMTP_HOST=smtp.example.com
DOCUMENSO_SMTP_PORT=587
DOCUMENSO_SMTP_USERNAME=documenso@example.com
DOCUMENSO_SMTP_PASSWORD={{password_32}}
DOCUMENSO_SMTP_FROM_NAME=Documenso
DOCUMENSO_SMTP_FROM_ADDRESS=documenso@example.com

DOCUMENSO_DB_HEALTHCHECK_INTERVAL=10s
DOCUMENSO_DB_HEALTHCHECK_TIMEOUT=5s
DOCUMENSO_DB_HEALTHCHECK_RETRIES=10
