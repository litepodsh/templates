# Used only by the commented host-port mapping in compose.yml.
GRIST_PORT=8484

# Public URL Grist is served from. Used to build share links and redirects.
GRIST_APP_HOME_URL=http://localhost:8484
GRIST_SESSION_SECRET={{openssl_rand_32}}

# The first user to log in with this email becomes the instance admin.
GRIST_DEFAULT_EMAIL=admin@example.com

# Require login for every page (recommended for a private instance).
GRIST_FORCE_LOGIN=true

# gvisor gives each document's Python sandbox strong isolation; use "unsandboxed"
# only if gvisor will not run in your environment.
GRIST_SANDBOX_FLAVOR=gvisor

# Pin the whole instance to a single team site. Leave empty for multi-team.
GRIST_SINGLE_ORG=
