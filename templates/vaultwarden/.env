# Used only by the commented host-port mapping in compose.yml.
VAULTWARDEN_PORT=8080

# External URL the web vault is served from. MUST be the real https:// origin
# for WebAuthn / passkeys / U2F to work.
VAULTWARDEN_DOMAIN=https://vault.example.com

# Lock the instance down after the first account is created.
VAULTWARDEN_SIGNUPS_ALLOWED=false
VAULTWARDEN_SIGNUPS_VERIFY=true
VAULTWARDEN_INVITATIONS_ALLOWED=true

# Enables the /admin panel. Generate an Argon2 hash with `vaultwarden hash`
# (see setup.md) and paste it here; a plain string also works but is weaker.
VAULTWARDEN_ADMIN_TOKEN={{openssl_rand_64}}

# SMTP for invitations, verification and hints. Replace with your provider.
VAULTWARDEN_SMTP_HOST=smtp.example.com
VAULTWARDEN_SMTP_FROM=vaultwarden@example.com
VAULTWARDEN_SMTP_PORT=587
VAULTWARDEN_SMTP_SECURITY=starttls
VAULTWARDEN_SMTP_USERNAME=vaultwarden@example.com
VAULTWARDEN_SMTP_PASSWORD={{password_32}}
