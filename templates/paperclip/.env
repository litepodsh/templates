# Public address of the instance. Required in public mode; used for sign-in and links.
PAPERCLIP_PUBLIC_URL={{url}}
# Extra hostnames the instance accepts besides the public URL host, comma-separated.
PAPERCLIP_ALLOWED_HOSTNAMES=

# Bundled PostgreSQL. The password is generated once; the server connects with these.
PAPERCLIP_DB_USER=paperclip
PAPERCLIP_DB_PASSWORD={{password_32}}
PAPERCLIP_DB_NAME=paperclip

# Session signing, and a separate secret for signed approval-gated tool actions.
# Keep both across restarts: replacing them logs everyone out and invalidates pending approvals.
BETTER_AUTH_SECRET={{openssl_rand_32}}
PAPERCLIP_TOOL_ACTION_SIGNING_SECRET={{openssl_rand_32}}

# Provider keys for the agent CLIs bundled in the image. At least one is needed for agents to run.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
