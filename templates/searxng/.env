# Host port for the web UI.
SEARXNG_PORT=8080

# Public URL SearXNG is served from. Needs the trailing slash.
SEARXNG_BASE_URL={{url}}/
# Signs result proxy links and cookies.
SEARXNG_SECRET={{openssl_rand_32}}
# Bot limiter. Needs Valkey/Redis; keep false for private instances.
SEARXNG_LIMITER=false
