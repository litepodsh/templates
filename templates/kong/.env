# Used only by the commented host-port mappings in compose.yml.
KONG_PROXY_PORT=8000
KONG_ADMIN_PORT=8001
KONG_MANAGER_PORT=8002

# URLs the BROWSER uses to reach Kong Manager and the Admin API. Kong Manager is
# a single-page app served on :8002 that talks to the Admin API on :8001 from
# the client side, so KONG_ADMIN_URL must be reachable from wherever you open
# the UI. Set both to your real hostnames when fronting Kong with a proxy, e.g.
#   KONG_ADMIN_URL=https://kong-admin.example.com
#   KONG_MANAGER_URL=https://kong-manager.example.com
KONG_ADMIN_URL=http://localhost:8001
KONG_MANAGER_URL=http://localhost:8002

KONG_PG_DATABASE=kong
KONG_PG_USER=kong
KONG_PG_PASSWORD={{password_32}}

KONG_DB_HEALTHCHECK_INTERVAL=10s
KONG_DB_HEALTHCHECK_TIMEOUT=5s
KONG_DB_HEALTHCHECK_RETRIES=10

KONG_HEALTHCHECK_INTERVAL=30s
KONG_HEALTHCHECK_TIMEOUT=10s
KONG_HEALTHCHECK_RETRIES=5
