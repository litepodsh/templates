# Admin account. With STORAGE_PROVIDER=sqlite this is only the bootstrap: the
# first boot copies it into the accounts table, and later sign-ins read that
# table. Change the password in Admin -> Accounts afterwards — editing it here
# only triggers a warning once the account exists.
LIBREDB_ADMIN_EMAIL=admin@libredb.org
LIBREDB_ADMIN_PASSWORD={{password_16_readable}}

# Session signing secret, at least 32 characters. Also derives the key that
# encrypts saved connection credentials, so rotating it makes stored passwords
# unreadable (re-enter them once).
LIBREDB_JWT_SECRET={{base64_32}}

# LitePod serves the app over plain HTTP on a generated domain, where a Secure
# cookie is silently dropped and login bounces back to the login page. Set this
# to true after attaching a domain with TLS.
LIBREDB_AUTH_COOKIE_SECURE=false

# local = email/password. See the LibreDB docs for OIDC single sign-on.
LIBREDB_AUTH_PROVIDER=local

# sqlite = server-side store on the libredb_data volume (connections, saved
# queries, audit trail). "local" keeps them in each browser's localStorage.
LIBREDB_STORAGE_PROVIDER=sqlite
LIBREDB_STORAGE_SQLITE_PATH=/app/data/libredb-storage.db

# Optional AI agent — configuring a model is the opt-in, there is no separate
# switch. Uncomment these and the matching lines in compose.yml.
# Provider: gemini | openai | ollama | custom
# LIBREDB_LLM_PROVIDER=gemini
# LIBREDB_LLM_API_KEY=
# LIBREDB_LLM_MODEL=gemini-2.5-flash
# LLM_API_URL is required for ollama/custom, e.g. http://ollama:11434/v1
# LIBREDB_LLM_API_URL=
